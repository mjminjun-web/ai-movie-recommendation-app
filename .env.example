GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Recommended movie and TV poster source. Keep this server-side.
TMDB_READ_ACCESS_TOKEN=

# TMDb v3 API keys are also supported as an alternative.
TMDB_API_KEY=

# Optional secondary metadata/poster source.
OMDB_API_KEY=

# Optional: KinoCheck works without a key up to its public daily limit.
KINOCHECK_API_KEY=

# Optional final trailer fallback. Enable YouTube Data API v3 for this key.
YOUTUBE_API_KEY=
